OPENAI_API_KEY=
DB_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional model overrides
# CHAT_MODEL=gpt-6-luna
# REASONING_EFFORT=low
# EMBED_MODEL=text-embedding-3-small

# Rate limiting / cost protection (per client IP; 0 disables a limit)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=6
RATE_LIMIT_CHAT_PER_DAY=100
RATE_LIMIT_UPLOAD_PER_HOUR=10
RATE_LIMIT_GLOBAL_PER_MINUTE=120
MAX_QUESTION_CHARS=1000
MAX_UPLOAD_MB=10
TRUST_PROXY=false
RATE_LIMIT_DELETE_PER_HOUR=20

# Comma-separated allowed browser origins ("*" = any, dev only)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
